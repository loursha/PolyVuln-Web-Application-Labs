<%- include('partials/header') %>
<div class="container py-5">
  <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div><h1 class="mb-1">Hello, <%= profile.full_name.split(' ')[0] %></h1><span class="text-muted">Member since <%= String(profile.created_at).slice(0, 4) %><% if (isVip) { %> · <span style="color:var(--peony)"><i class="bi bi-stars"></i> Petal Club</span><% } %></span></div>
    <a class="btn btn-primary" href="/shop">Send flowers</a>
  </div>
  <div class="row g-3 mb-5">
    <div class="col-6 col-md-3"><div class="kpi"><div class="v"><%= orders.length %></div><div class="l">Orders</div></div></div>
    <div class="col-6 col-md-3"><div class="kpi"><div class="v"><%= money(spend) %></div><div class="l">Total spent</div></div></div>
    <div class="col-6 col-md-3"><div class="kpi"><div class="v"><%= orders.filter(o => ['received','arranging','out_for_delivery'].includes(o.status)).length %></div><div class="l">On the way</div></div></div>
    <div class="col-6 col-md-3"><div class="kpi"><div class="v"><%= isVip ? '15%' : '—' %></div><div class="l">Member discount</div></div></div>
  </div>

  <ul class="nav nav-pills mb-4 gap-2" role="tablist">
    <li class="nav-item" role="presentation"><button class="nav-link active rounded-pill" data-bs-toggle="pill" data-bs-target="#orders" type="button" role="tab">Orders</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link rounded-pill" data-bs-toggle="pill" data-bs-target="#settings" type="button" role="tab">Settings</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link rounded-pill" data-bs-toggle="pill" data-bs-target="#prefs" type="button" role="tab">Preferences</button></li>
  </ul>

  <div class="tab-content">
    <div class="tab-pane fade show active" id="orders" role="tabpanel">
      <% if (!orders.length) { %><div class="panel panel-sage text-center py-5"><h3>No orders yet</h3><p class="text-muted">When you send flowers, you'll see them here with tracking and invoices.</p><a class="btn btn-primary" href="/shop">Shop flowers</a></div><% } else { %>
      <div class="table-responsive panel p-0"><table class="table table-hover align-middle mb-0">
        <thead><tr><th class="ps-4">Order</th><th>Recipient</th><th>Delivery</th><th>Status</th><th class="text-end">Total</th><th class="pe-4 text-end">Invoice</th></tr></thead>
        <tbody><% orders.forEach(o => { %>
          <tr><td class="ps-4"><a href="/order/<%= o.order_number %>"><%= o.order_number %></a></td><td><%= o.recipient_name %></td><td><%= String(o.delivery_date).slice(0, 10) %></td>
          <td><span class="status status-<%= o.status %>"><%= o.status.replace(/_/g, ' ') %></span></td><td class="text-end"><%= money(o.total) %></td>
          <td class="pe-4 text-end"><a class="btn btn-sm btn-outline-primary" href="/account/invoices/download?file=INV-<%= o.order_number %>.pdf"><i class="bi bi-download"></i> PDF</a></td></tr>
        <% }) %></tbody>
      </table></div><% } %>
    </div>

    <div class="tab-pane fade" id="settings" role="tabpanel">
      <div class="row g-4">
        <div class="col-lg-6">
          <form class="panel mb-4" method="post" action="/account/profile">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <h3 class="mb-3">Profile</h3>
            <div class="mb-3"><label class="form-label" for="full_name">Full name</label><input class="form-control" id="full_name" name="full_name" value="<%= profile.full_name %>"></div>
            <div class="mb-3"><label class="form-label" for="phone">Phone</label><input class="form-control" id="phone" name="phone" value="<%= profile.phone %>"></div>
            <div class="mb-3"><label class="form-label" for="address">Default delivery address</label><input class="form-control" id="address" name="address" value="<%= profile.address %>"></div>
            <button class="btn btn-primary">Save profile</button>
          </form>
          <form class="panel" method="post" action="/account/email">
            <h3 class="mb-3">Email address</h3>
            <p class="text-muted">Order confirmations and password reset codes go here.</p>
            <div class="mb-3"><label class="form-label" for="email">Email</label><input class="form-control" type="email" id="email" name="email" value="<%= profile.email %>"></div>
            <button class="btn btn-primary">Update email</button>
          </form>
        </div>
        <div class="col-lg-6">
          <form class="panel mb-4" method="post" action="/account/password">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <h3 class="mb-3">Change password</h3>
            <div class="mb-3"><label class="form-label" for="current">Current password</label><input class="form-control" type="password" id="current" name="current" autocomplete="current-password"></div>
            <div class="mb-3"><label class="form-label" for="newpw">New password</label><input class="form-control" type="password" id="newpw" name="password" minlength="8" autocomplete="new-password"></div>
            <button class="btn btn-primary">Change password</button>
          </form>
          <form class="panel" method="post" action="/account/close" style="border-color:#f1c9d5">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <h3 class="mb-2">Close account</h3>
            <p class="text-muted">Your order history is kept for tax records. You won't be able to sign in again without contacting us.</p>
            <button class="btn btn-peony" id="closeAccountBtn">Close my account</button>
          </form>
        </div>
      </div>
    </div>

    <div class="tab-pane fade" id="prefs" role="tabpanel">
      <form class="panel" id="prefsForm" style="max-width:640px">
        <h3 class="mb-3">Delivery &amp; marketing preferences</h3>
        <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" id="newsletter"><label class="form-check-label" for="newsletter">Seasonal newsletter</label></div>
        <div class="form-check form-switch mb-3"><input class="form-check-input" type="checkbox" id="sms"><label class="form-check-label" for="sms">Text me when my order is out for delivery</label></div>
        <div class="mb-3"><label class="form-label" for="favoriteFlower">Favourite flower</label><input class="form-control" id="favoriteFlower" maxlength="40"></div>
        <div class="mb-3"><label class="form-label" for="deliveryNotes">Delivery notes for drivers</label><input class="form-control" id="deliveryNotes" maxlength="200" placeholder="e.g. Leave with the concierge"></div>
        <button class="btn btn-primary" type="submit">Save preferences</button> <span id="prefsMsg" class="ms-2 text-muted"></span>
      </form>
    </div>
  </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
  if (location.hash) { var t = document.querySelector('[data-bs-target="' + location.hash + '"]'); if (t) bootstrap.Tab.getOrCreateInstance(t).show(); }
  var f = document.getElementById('prefsForm'), ids = ['newsletter', 'sms', 'favoriteFlower', 'deliveryNotes'];
  fetch('/api/v1/preferences').then(function (r) { return r.json(); }).then(function (p) {
    ids.forEach(function (k) { var el = document.getElementById(k); if (el.type === 'checkbox') el.checked = !!p[k]; else el.value = p[k] || ''; });
  });
  f.addEventListener('submit', function (e) {
    e.preventDefault(); var body = {};
    ids.forEach(function (k) { var el = document.getElementById(k); body[k] = el.type === 'checkbox' ? el.checked : el.value; });
    fetch('/api/v1/preferences', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' }, body: JSON.stringify(body) })
      .then(function (r) { return r.json(); }).then(function (d) { document.getElementById('prefsMsg').textContent = d.saved ? 'Preferences saved.' : (d.error || 'Could not save.'); });
  });
});
</script>
<%- include('partials/footer') %>
