<%- include('partials/header') %>
<div class="container py-5">
  <h1 class="mb-4">Checkout</h1>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <form method="post" action="/checkout" class="row g-5" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="col-lg-7">
      <h3 class="mb-3">Delivery</h3>
      <div class="row g-3 mb-4">
        <div class="col-md-6"><label class="form-label" for="recipient">Recipient's name</label><input class="form-control" id="recipient" name="recipient" required value="<%= form.recipient || profile.full_name || '' %>"></div>
        <div class="col-md-6"><label class="form-label" for="date">Delivery date</label><input class="form-control" type="date" id="date" name="date" required value="<%= form.date || tomorrow %>"></div>
        <div class="col-12"><label class="form-label" for="address">Delivery address</label><input class="form-control" id="address" name="address" required value="<%= form.address || profile.address || '' %>"></div>
        <div class="col-12"><label class="form-label" for="message">Card message <span class="text-muted fw-normal">(optional)</span></label><textarea class="form-control" id="message" name="message" rows="2" maxlength="300" placeholder="We'll handwrite this on a card"><%= form.message || '' %></textarea></div>
      </div>
      <h3 class="mb-3">Payment</h3>
      <div class="row g-3">
        <div class="col-12"><label class="form-label" for="card">Card number</label><input class="form-control" id="card" name="card" inputmode="numeric" autocomplete="cc-number" placeholder="4242 4242 4242 4242" required></div>
        <div class="col-6"><label class="form-label" for="expiry">Expiry (MM/YY)</label><input class="form-control" id="expiry" name="expiry" placeholder="08/28" autocomplete="cc-exp" required></div>
        <div class="col-6"><label class="form-label" for="cvc">Security code</label><input class="form-control" id="cvc" name="cvc" inputmode="numeric" autocomplete="cc-csc" placeholder="123" required></div>
      </div>
      <p class="small text-muted mt-3"><i class="bi bi-info-circle"></i> Training lab: use any test card number such as 4242 4242 4242 4242.</p>
    </div>
    <div class="col-lg-5">
      <div class="panel">
        <h3 class="mb-3">Your order</h3>
        <% items.forEach(i => { %><div class="d-flex justify-content-between mb-2"><span><%= i.qty %> × <%= i.name %></span><span><%= money(i.price * i.qty) %></span></div><% }) %>
        <hr>
        <div class="d-flex justify-content-between mb-1"><span>Subtotal</span><span><%= money(t.subtotal) %></span></div>
        <% if (t.discount) { %><div class="d-flex justify-content-between mb-1"><span>Discount</span><span>−<%= money(t.discount) %></span></div><% } %>
        <div class="d-flex justify-content-between mb-3"><span>Delivery</span><span><%= t.delivery ? money(t.delivery) : 'Free' %></span></div>
        <div class="d-flex justify-content-between fs-4 fw-bold mb-3"><span>Total</span><span><%= money(t.total) %></span></div>
        <button class="btn btn-primary btn-lg w-100">Pay <%= money(t.total) %></button>
      </div>
    </div>
  </form>
</div>
<%- include('partials/footer') %>
