<%- include('partials/header') %>
<div class="container py-5" style="max-width:860px">
  <h1 class="mb-2">Track your order</h1>
  <p class="text-muted mb-4">Enter the order number from your confirmation email, for example PS-10421.</p>
  <form class="d-flex gap-2 mb-4" method="get" action="/track">
    <label for="order" class="visually-hidden">Order number</label>
    <input class="form-control form-control-lg" id="order" name="order" value="<%= ref %>" placeholder="PS-10421" required>
    <button class="btn btn-primary btn-lg px-4">Track</button>
  </form>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <% if (results && !results.length) { %><div class="alert alert-danger">We couldn't find an order with that number. Check your confirmation email and try again.</div><% } %>
  <% if (results && results.length) { results.forEach(o => { const steps = ['received','arranging','out_for_delivery','delivered']; const idx = steps.indexOf(o.status); %>
    <div class="panel mb-3">
      <div class="d-flex justify-content-between flex-wrap gap-2 mb-3">
        <div><h3 class="mb-0"><%= o.order_number %></h3><span class="text-muted">For <%= o.recipient_name %> · <%= String(o.delivery_date).slice(0, 10) %></span></div>
        <div class="text-end"><span class="status status-<%= o.status %>"><%= String(o.status).replace(/_/g, ' ') %></span><div class="fw-bold mt-1"><%= isNaN(Number(o.total)) ? o.total : money(o.total) %></div></div>
      </div>
      <% if (idx >= 0) { %>
      <div class="progress" role="progressbar" aria-label="Delivery progress" aria-valuenow="<%= idx + 1 %>" aria-valuemin="0" aria-valuemax="4" style="height:8px"><div class="progress-bar" style="width:<%= (idx + 1) * 25 %>%;background:var(--peony)"></div></div>
      <div class="d-flex justify-content-between small text-muted mt-2"><span>Received</span><span>Arranging</span><span>Out for delivery</span><span>Delivered</span></div>
      <% } %>
    </div>
  <% }) } %>
</div>
<%- include('partials/footer') %>
