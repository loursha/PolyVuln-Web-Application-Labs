<%- include('partials/header') %>
<div class="container py-5" style="max-width:820px">
  <div class="text-center mb-5">
    <div class="display-serif mb-2" style="font-size:3.5rem;color:var(--peony)">✿</div>
    <h1>Thank you, your order is in.</h1>
    <p class="text-muted">Order <strong><%= order.order_number %></strong> will be delivered to <%= order.recipient_name %> on <%= String(order.delivery_date).slice(0, 10) %>.</p>
  </div>
  <div class="panel">
    <% items.forEach(i => { %><div class="d-flex justify-content-between mb-2"><span><%= i.qty %> × <%= i.product_name %></span><span><%= money(i.unit_price * i.qty) %></span></div><% }) %>
    <hr><div class="d-flex justify-content-between fw-bold fs-5"><span>Total paid</span><span><%= money(order.total) %></span></div>
  </div>
  <div class="d-flex gap-2 justify-content-center mt-4">
    <a class="btn btn-primary" href="/account/invoices/download?file=INV-<%= order.order_number %>.pdf"><i class="bi bi-file-earmark-pdf"></i> Download invoice</a>
    <a class="btn btn-outline-primary" href="/track?order=<%= order.order_number %>">Track delivery</a>
  </div>
</div>
<%- include('partials/footer') %>
